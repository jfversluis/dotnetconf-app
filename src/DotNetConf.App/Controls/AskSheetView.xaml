<ContentView x:Class="DotNetConf.App.Controls.AskSheetView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DotNetConf.App.Controls"
             xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
             xmlns:core="clr-namespace:DotNetConf.Core;assembly=DotNetConf.Core"
             x:DataType="vm:AskViewModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
    <ScrollView AutomationId="ask-content">
        <ScrollView.SafeAreaEdges>
            <OnPlatform x:TypeArguments="SafeAreaEdges" Default="Container,Container,Container,All">
                <On Platform="Android" Value="Container,Container,Container,None" />
            </OnPlatform>
        </ScrollView.SafeAreaEdges>
        <Grid RowDefinitions="Auto,Auto,Auto" Padding="12,4,12,16" MaximumWidthRequest="720" SafeAreaEdges="None"
              HorizontalOptions="Fill">
            <Grid ColumnDefinitions="*,Auto" Padding="12,0">
                <Label Text="Ask" Style="{StaticResource Heading}" VerticalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />
                <ImageButton Grid.Column="1" Source="{StaticResource ClearIcon}" Style="{StaticResource IconButton}"
                             Clicked="CloseClicked" AutomationId="ask-close" SemanticProperties.Description="Close Ask" />
            </Grid>
            <AbsoluteLayout Grid.Row="1" MinimumHeightRequest="112" AutomationId="ask-composer">
                <controls:AskGlow x:Name="Glow" IsWorking="{Binding IsBusy}"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1" AbsoluteLayout.LayoutFlags="All" />
                <Grid Padding="26,20" RowDefinitions="Auto,Auto" RowSpacing="4"
                      AbsoluteLayout.LayoutBounds="0,0,1,AutoSize" AbsoluteLayout.LayoutFlags="WidthProportional">
                    <controls:AskEditor x:Name="Input" MinimumHeightRequest="48" MaximumHeightRequest="140"
                            AutoSize="TextChanges" MaxLength="500" Text="{Binding Request, Mode=TwoWay}"
                            Placeholder="Ask about .NET Conf" IsEnabled="{Binding CanSubmit}"
                            TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"
                            BackgroundColor="Transparent" AutomationId="ask-input"
                            SemanticProperties.Description="Ask about conference sessions and your schedule"
                            Focused="InputFocused" Unfocused="InputUnfocused" Completed="InputCompleted" />
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <Label Text="Using on-device AI" Style="{StaticResource Secondary}"
                               FontSize="12" VerticalOptions="Center" />
                        <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center" AutomationId="ask-progress" />
                        <Grid Grid.Column="2" WidthRequest="48" HeightRequest="48" AutomationId="ask-send-target">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid"
                                             Binding="{Binding Source={x:Reference SendButton}, Path=IsEnabled, x:DataType=ImageButton}" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                    HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"
                                    AutomationProperties.IsInAccessibleTree="False" AutomationId="ask-send-disc"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                            <ImageButton x:Name="SendButton" Command="{Binding SubmitCommand}" Source="{StaticResource AskSendIcon}"
                                         Style="{StaticResource IconButton}" Padding="14"
                                         AutomationId="ask-submit" SemanticProperties.Description="Send request"
                                         SemanticProperties.Hint="Finds a conference action for your request">
                                <ImageButton.Triggers>
                                    <DataTrigger TargetType="ImageButton" Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Command" Value="{Binding StopCommand}" />
                                        <Setter Property="Source" Value="{StaticResource AskStopIcon}" />
                                        <Setter Property="AutomationId" Value="ask-stop" />
                                        <Setter Property="SemanticProperties.Description" Value="Stop request" />
                                        <Setter Property="SemanticProperties.Hint" Value="Cancels the current on-device request" />
                                    </DataTrigger>
                                </ImageButton.Triggers>
                            </ImageButton>
                        </Grid>
                    </Grid>
                </Grid>
            </AbsoluteLayout>
            <VerticalStackLayout Grid.Row="2" Spacing="16" Padding="12,16">
                <Label Text="{Binding Message}" AutomationId="ask-message" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Choices}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="core:AskChoice">
                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" Padding="0,8">
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                <Label Grid.Row="1" Text="{Binding Detail}" Style="{StaticResource Secondary}" />
                                <Button Grid.Column="1" Grid.RowSpan="2" Text="Choose"
                                        Style="{StaticResource QuietButton}" CommandParameter="{Binding .}"
                                        Clicked="ChoiceClicked" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:AskViewModel}}, Path=NeedsChoice}"
                                        SemanticProperties.Description="{Binding Title, StringFormat='Choose {0}'}"
                                        AutomationId="ask-choice" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding NeedsApproval}">
                    <Label Text="Only these saved choices will be removed. You can save them again using hearts."
                           Style="{StaticResource Secondary}" />
                    <Button Text="Remove sessions" Command="{Binding ConfirmRemovalCommand}"
                            SemanticProperties.Description="Remove these saved sessions"
                            AutomationId="ask-confirm-removal" />
                    <Button Text="Keep my schedule" Command="{Binding DeclineCommand}"
                            Style="{StaticResource QuietButton}" AutomationId="ask-decline-removal" />
                </VerticalStackLayout>
                <Button Text="View My Schedule" IsVisible="{Binding CanViewSchedule}" Clicked="ViewScheduleClicked"
                        Style="{StaticResource QuietButton}" AutomationId="ask-view-schedule" />
                <VerticalStackLayout x:Name="DebugSlot" IsVisible="False"
                                     AutomationProperties.ExcludedWithChildren="True" />
                <Label Text="Check the result. Removals always need your confirmation."
                       Style="{StaticResource Secondary}" FontSize="12" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentView>
