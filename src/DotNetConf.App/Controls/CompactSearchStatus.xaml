<ContentView x:Class="DotNetConf.App.Controls.CompactSearchStatus"
             xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
             x:DataType="vm:ConferenceViewModel">
    <Grid IsVisible="{Binding HasRefreshError}" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <Label Text="{Binding RefreshMessage}" Style="{StaticResource Secondary}" FontSize="12" MaxLines="2"
               LineBreakMode="TailTruncation"
               TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
               VerticalOptions="Center" SemanticProperties.Description="{Binding RefreshMessage}"
               AutomationId="agenda-compact-error" />
        <Button Grid.Column="1" Text="Details" Clicked="ShowDetailsClicked"
                Style="{StaticResource QuietButton}" BorderWidth="0" Padding="8,4" FontSize="13"
                SemanticProperties.Hint="Read the full issue and retry."
                AutomationId="agenda-compact-details" />
    </Grid>
</ContentView>
