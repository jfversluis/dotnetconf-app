<ContentView x:Class="DotNetConf.App.Controls.PlannerView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
             xmlns:services="clr-namespace:DotNetConf.App.Services"
             x:DataType="vm:PlannerViewModel" SafeAreaEdges="None">
    <ContentView.Resources>
        <Style x:Key="StartingPointButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="DisclosureButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentView.Resources>
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None">
    <VerticalStackLayout IsVisible="{Binding HasStatus}" Padding="24,12" Spacing="8"
                         BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                         AutomationId="planner-model-state">
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ScrollView x:Name="StatusScroll" MaximumHeightRequest="240" VerticalScrollBarVisibility="Always"
                        AutomationId="planner-status-scroll">
                <Label x:Name="StatusLabel" Text="{Binding Status}" AutomationId="planner-status" />
            </ScrollView>
            <Label x:Name="StatusScrollHint" Grid.Column="1" Text="Scroll" IsVisible="False"
                   Style="{StaticResource Secondary}" FontSize="13" VerticalOptions="End"
                   SemanticProperties.Description="Scroll to read the full message."
                   AutomationId="planner-status-scroll-hint" />
        </Grid>
        <Button Text="Cancel suggestions" LineBreakMode="WordWrap" Command="{Binding CancelCommand}" IsVisible="{Binding CanCancel}"
                Style="{StaticResource QuietButton}" AutomationId="planner-cancel" />
    </VerticalStackLayout>
    <ScrollView x:Name="PlannerScroll" Grid.Row="1" SafeAreaEdges="Default" AutomationId="planner-scroll">
        <VerticalStackLayout Spacing="0" MaximumWidthRequest="720" HorizontalOptions="Fill" SafeAreaEdges="None">
            <Grid SafeAreaEdges="None" Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}">
                <VerticalStackLayout x:Name="HeroContent" Padding="24,32,24,28" Spacing="24" SafeAreaEdges="None">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Image Source="{StaticResource DiscoveryIcon}" HeightRequest="48" WidthRequest="48"
                               HorizontalOptions="Start" InputTransparent="True"
                               AutomationProperties.IsInAccessibleTree="False" AutomationId="planner-hero-icon">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding IsAiMode}" Value="True">
                                    <Setter Property="Source" Value="{StaticResource PlannerIcon}" />
                                </DataTrigger>
                            </Image.Triggers>
                        </Image>
                        <ContentView x:Name="HeroAction" Grid.Column="1" VerticalOptions="Center" />
                    </Grid>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="{Binding Heading}" Style="{StaticResource Heading}" FontSize="34"
                               AutomationId="planner-welcome" />
                        <Label Text="{Binding Introduction}"
                               FontSize="18" MaximumWidthRequest="520" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Padding="24,20,24,24" Spacing="20" SafeAreaEdges="None">
                <VerticalStackLayout IsVisible="{Binding ShowDiscoveryActions}" Spacing="8" AutomationId="planner-discovery-actions">
                    <VerticalStackLayout IsVisible="{Binding CanExplore}" Spacing="8">
                        <Button Text="Explore a mix / Shuffle suggestions" Command="{Binding ExploreCommand}"
                                IsEnabled="{Binding CanEdit}" ImageSource="{StaticResource DiscoveryActionIcon}"
                                ContentLayout="Left,8" LineBreakMode="WordWrap" AutomationId="planner-explore" />
                        <Label Text="Replaces this preview, not saved talks."
                               IsVisible="{Binding HasProposal}" Style="{StaticResource Secondary}" FontSize="13"
                               SemanticProperties.Description="Shuffle replaces this unsaved preview. Your saved schedule stays unchanged."
                               AutomationId="planner-shuffle-guidance" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Review shortlist" IsVisible="{Binding HasProposal}" IsEnabled="{Binding CanEdit}" Clicked="ReviewShortlistClicked"
                                Style="{StaticResource DisclosureButton}" FontSize="14" MinimumHeightRequest="48"
                                SemanticProperties.Hint="Moves to the current suggestions, which are not saved yet."
                                AutomationId="planner-review-shortlist" />
                        <Button Grid.Column="1" Text="AI setup" IsVisible="{Binding ShowModelSetup}" Clicked="ShowModelSetupClicked"
                                Style="{StaticResource DisclosureButton}" FontSize="14" MinimumHeightRequest="48"
                                SemanticProperties.Hint="Moves to on-device AI setup and availability."
                                AutomationId="planner-open-model-setup">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding HasProposal}" Value="False">
                                    <Setter Property="Grid.Column" Value="0" />
                                    <Setter Property="Grid.ColumnSpan" Value="2" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </VerticalStackLayout>
                <Label Text="{Binding ModelStatus}" IsVisible="{Binding ShowAvailabilityStatus}"
                       Style="{StaticResource Secondary}" FontSize="13"
                       AutomationId="planner-ai-availability" />
                <ActivityIndicator IsRunning="{Binding IsCheckingModel}" IsVisible="{Binding IsCheckingModel}"
                                   HorizontalOptions="Start" SemanticProperties.Description="Checking optional on-device AI" />
                <VerticalStackLayout IsVisible="{Binding IsAiMode}" Spacing="16" AutomationId="planner-ai-actions">
                <VerticalStackLayout Spacing="8" IsVisible="{Binding CanEdit}">
                    <Label Text="Need a starting point?" Style="{StaticResource Secondary}" FontSize="14" />
                    <ActivityIndicator IsRunning="{Binding IsLoadingStartingPoints}" IsVisible="{Binding IsLoadingStartingPoints}"
                                       HeightRequest="24" WidthRequest="24" HorizontalOptions="Start"
                                       SemanticProperties.Description="Preparing starting points"
                                       AutomationId="planner-starting-points-loading" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                                AutomationId="planner-starting-points">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding StartingPoints}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="services:PlannerStartingPoint">
                                    <Button Text="{Binding Label}" Style="{StaticResource StartingPointButton}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PlannerViewModel}}, Path=UseExampleCommand}"
                                            CommandParameter="{Binding Request}"
                                            AutomationId="{Binding Label, StringFormat='planner-example-{0}'}" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding RequestLabel}" Style="{StaticResource Subheading}" />
                    <Border Padding="12,8" StrokeShape="RoundRectangle 8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                        <!-- Android uses the shared hint/placeholder to preserve TalkBack editing actions. -->
                        <Editor x:Name="RequestEditor" Text="{Binding Request}" AutoSize="TextChanges" MinimumHeightRequest="112"
                                MaxLength="1200" IsEnabled="{Binding CanEdit}" FontAutoScalingEnabled="True"
                                FontFamily="OpenSansRegular" FontSize="16"
                                TextColor="{AppThemeBinding Light={StaticResource LightText}, Dark={StaticResource DarkText}}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"
                                BackgroundColor="Transparent"
                                Placeholder="Describe topics, speakers, or available dates and times"
                                SemanticProperties.Description="{OnPlatform iOS='What interests you?'}"
                                SemanticProperties.Hint="Describe topics, speakers, or available dates and times"
                                AutomationId="planner-request" />
                    </Border>
                    <Label Text="{Binding TimeZoneLabel}" Style="{StaticResource Secondary}" FontSize="13" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <Label Text="{Binding WatchingHoursSummary}" Style="{StaticResource Secondary}" FontSize="14"
                               VerticalOptions="Center" AutomationId="planner-watching-summary" />
                        <Button Grid.Column="1" Text="{Binding WatchingHoursAction}"
                                Command="{Binding ToggleWatchingHoursCommand}" IsEnabled="{Binding CanEdit}"
                                Style="{StaticResource DisclosureButton}" MinimumWidthRequest="64"
                                SemanticProperties.Description="{Binding WatchingHoursActionDescription}"
                                AutomationId="planner-toggle-watching-hours" />
                    </Grid>
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowWatchingHours}"
                                         AutomationId="planner-watching-options">
                        <Label Text="Fills unstated times only. Explicit hours take priority; no time limits means unrestricted."
                               Style="{StaticResource Secondary}" FontSize="14" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Start" />
                                <TimePicker Time="{Binding WatchingStart}" Format="HH:mm" IsEnabled="{Binding CanEdit}"
                                            MinimumHeightRequest="48" AutomationId="planner-watching-start"
                                            SemanticProperties.Description="Default watching start time" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Finish" />
                                <TimePicker Time="{Binding WatchingEnd}" Format="HH:mm" IsEnabled="{Binding CanEdit}"
                                            MinimumHeightRequest="48" AutomationId="planner-watching-end"
                                            SemanticProperties.Description="Default watching finish time" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="You can name another time zone in your request."
                               Style="{StaticResource Secondary}" FontSize="13" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <Button Text="{Binding GenerateLabel}" LineBreakMode="WordWrap" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}"
                        Clicked="GenerateClicked" AutomationId="planner-generate" />
                <Label Text="On-device with Essentials.AI on supported devices. No app account or cloud AI."
                       Style="{StaticResource Secondary}" FontSize="13" />
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding HasProposal}" Spacing="16" AutomationId="planner-preview">
                    <BoxView HeightRequest="1" Margin="0,4" />
                    <Label x:Name="ShortlistHeading" Text="Your shortlist" Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level2"
                           AutomationId="planner-shortlist-heading" />
                    <Label Text="{Binding DiscoverySource}" Style="{StaticResource Secondary}" FontSize="14" />
                    <Label Text="{Binding SelectionSummary}" AutomationId="planner-selection-summary" />
                    <Label Text="{Binding AvailabilityAssumption}" IsVisible="{Binding HasAvailabilityAssumption}"
                           Style="{StaticResource Secondary}" FontSize="14" AutomationId="planner-availability-assumption" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sessions}" Spacing="16">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProposedSessionViewModel">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" AutomationId="{Binding AutomationId}">
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                              Color="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}"
                                              MinimumHeightRequest="48" MinimumWidthRequest="48" VerticalOptions="Start"
                                              AutomationId="{Binding SelectionAutomationId}"
                                              SemanticProperties.Description="{Binding SelectionDescription}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding SpeakerNames}" Style="{StaticResource Secondary}" FontSize="14" />
                                        <Label Text="{Binding Time}" Style="{StaticResource Secondary}" FontSize="14" />
                                        <Label Text="{Binding Warning}" IsVisible="{Binding HasWarning}"
                                               TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                                               AutomationId="{Binding WarningAutomationId}" FontFamily="OpenSansSemibold" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="{Binding MatchingDetailsAction}" LineBreakMode="WordWrap" IsVisible="{Binding IsAiMode}"
                            Command="{Binding ToggleMatchingDetailsCommand}" Style="{StaticResource DisclosureButton}"
                            HorizontalOptions="Start"
                            AutomationId="planner-toggle-details" />
                    <VerticalStackLayout IsVisible="{Binding ShowMatchingDetails}" Spacing="8"
                                         AutomationId="planner-matching-details">
                        <Label Text="{Binding Constraints}" AutomationId="planner-constraints" />
                        <Label Text="Focused topic matches favor titles and descriptions; agenda tags are a fallback. Ask for all topic sessions to include tag-only matches too."
                               Style="{StaticResource Secondary}" FontSize="14" />
                        <Label Text="AI can misunderstand. If an interest, speaker or time is wrong, edit your request and try again."
                               Style="{StaticResource Secondary}" FontSize="14" />
                    </VerticalStackLayout>
                    <Label Text="{Binding Validation}" IsVisible="{Binding HasValidationErrors}" AutomationId="planner-validation"
                           TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}" />
                    <Button Text="Let me choose a subset instead" Command="{Binding ChooseSubsetCommand}"
                            IsVisible="{Binding CanRelaxConstraints}" IsEnabled="{Binding CanEdit}"
                            Style="{StaticResource QuietButton}" LineBreakMode="WordWrap"
                            AutomationId="planner-choose-subset" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsAiMode}">
                        <CheckBox IsChecked="{Binding ConstraintsConfirmed}" IsEnabled="{Binding CanConfirm}"
                                  Color="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}"
                                  MinimumHeightRequest="48" MinimumWidthRequest="48"
                                  SemanticProperties.Description="I have reviewed the selected sessions and their times"
                                  AutomationId="planner-confirm-constraints" />
                        <Label Grid.Column="1" Text="I've reviewed these sessions and times." VerticalOptions="Center" />
                    </Grid>
                    <Button Text="{Binding ApplyLabel}" LineBreakMode="WordWrap" Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding CanApply}" AutomationId="planner-apply" />
                </VerticalStackLayout>
                <Border x:Name="ModelSetup" Padding="20" StrokeShape="RoundRectangle 12" IsVisible="{Binding ShowModelSetup}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                        AutomationId="planner-model-setup">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding ModelSetupHeading}" Style="{StaticResource Subheading}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding ModelStatus}" AutomationId="planner-model-status" />
                        <Label Text="{Binding ModelDownloadDisclosure}" IsVisible="{Binding CanOfferModelSetup}"
                               Style="{StaticResource Secondary}" FontSize="14" AutomationId="planner-download-disclosure" />
                        <Label Text="Checking or setting up AI can replace this unsaved preview. Your saved talks stay as they are."
                               IsVisible="{Binding HasProposal}" Style="{StaticResource Secondary}" FontSize="14" />
                        <Button Text="Download on-device model" Command="{Binding DownloadModelCommand}"
                                IsVisible="{Binding CanDownloadModel}" IsEnabled="{Binding CanDownloadModel}"
                                LineBreakMode="WordWrap" MinimumHeightRequest="48"
                                SemanticProperties.Hint="Starts the Gemini Nano download using your internet connection"
                                AutomationId="planner-download-model" />
                        <ActivityIndicator IsRunning="{Binding IsDownloadingModel}" IsVisible="{Binding IsDownloadingModel}"
                                           HorizontalOptions="Start" SemanticProperties.Description="Preparing the on-device model" />
                        <ProgressBar Progress="{Binding DownloadProgress}" IsVisible="{Binding HasDownloadProgress}"
                                     SemanticProperties.Description="{Binding DownloadProgressText}"
                                     AutomationId="planner-download-progress" />
                        <Label Text="{Binding DownloadProgressText}" IsVisible="{Binding IsDownloadingModel}"
                               Style="{StaticResource Secondary}" FontSize="14" AutomationId="planner-download-progress-text" />
                        <Label Text="You can leave this screen or stop waiting. Android may continue the download in the background."
                               IsVisible="{Binding IsDownloadingModel}" Style="{StaticResource Secondary}" FontSize="14" />
                        <Button Text="Stop waiting" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloadingModel}"
                                Style="{StaticResource QuietButton}" LineBreakMode="WordWrap" MinimumHeightRequest="48"
                                AutomationId="planner-stop-download-wait" />
                        <Button Text="Check again" Command="{Binding CheckModelCommand}" IsVisible="{Binding CanRetryModel}"
                                Style="{StaticResource QuietButton}" LineBreakMode="WordWrap" MinimumHeightRequest="48"
                                AutomationId="planner-check-model" />
                        <Label Text="Prefer to jump straight in? Browse Sessions and tap hearts to build My Schedule. You can try AI planning later."
                               Style="{StaticResource Secondary}" FontSize="14" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding AgendaDisclosure}"
                       Style="{StaticResource Secondary}" FontSize="13" AutomationId="planner-agenda-disclosure" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentView>
