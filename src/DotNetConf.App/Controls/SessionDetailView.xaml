<ContentView x:Class="DotNetConf.App.Controls.SessionDetailView" x:Name="DetailView"
             xmlns:controls="clr-namespace:DotNetConf.App.Controls"
             xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
             x:DataType="vm:SessionViewModel">
    <Grid SafeAreaEdges="Container,None,Container,None">
    <ScrollView SafeAreaEdges="Default" AutomationId="session-detail-scroll">
        <VerticalStackLayout Padding="24" Spacing="24" MaximumWidthRequest="720" HorizontalOptions="Center" SafeAreaEdges="None">
            <controls:StatusBanner x:Name="Status" />
            <Label x:Name="NotFound" Text="Session not found. Go back to the agenda and choose a session."
                   AutomationId="session-not-found" />
            <VerticalStackLayout x:Name="Details" Spacing="24" IsVisible="False">
                <VerticalStackLayout Spacing="12">
                    <Label Text="This session is no longer in the published agenda. It stays saved until you remove it."
                           IsVisible="{Binding IsWithdrawn}"
                           TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}"
                           AutomationId="session-withdrawn" />
                    <Grid ColumnDefinitions="*,Auto,48" ColumnSpacing="12">
                        <Label Text="{Binding Title}" Style="{StaticResource Heading}" AutomationId="session-detail-title" />
                        <ContentView Grid.Column="1"
                                     IsVisible="{Binding Source={x:Reference DetailView}, Path=ShowInlineShare, x:DataType=controls:SessionDetailView}">
                            <ImageButton Command="{Binding ShareCommand}" Source="{StaticResource ShareIcon}"
                                         IsVisible="{Binding CanShare}" Style="{StaticResource IconButton}" VerticalOptions="Start"
                                         AutomationId="session-inline-share" SemanticProperties.Description="{Binding ShareLabel}"
                                         SemanticProperties.Hint="{Binding ShareHint}" />
                        </ContentView>
                        <ImageButton Grid.Column="2" Command="{Binding ToggleSaveCommand}"
                                     Style="{StaticResource IconButton}" VerticalOptions="Start"
                                     AutomationId="detail-save" SemanticProperties.Description="{Binding SaveHint}">
                            <ImageButton.Source>
                                <FontImageSource Glyph="{Binding SaveGlyph}" FontFamily="{Binding SaveFontFamily}" Size="24"
                                                 Color="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>
                    <Label Text="{Binding TopicLabel}" Style="{StaticResource Secondary}" />
                    <Label Text="{Binding DateLabel}" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding TimeLabel}" />
                    <Label x:Name="TimeZone" Style="{StaticResource Secondary}" FontSize="12" />
                    <Label Text="Overlaps another saved session" IsVisible="{Binding HasConflict}"
                           TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasWatchActions}">
                    <Button Text="Watch session" Command="{Binding WatchRecordingCommand}"
                            Style="{StaticResource ConferenceAction}" ImageSource="{StaticResource PrimaryVideoIcon}"
                            IsVisible="{Binding HasRecording}" AutomationId="session-watch-recording"
                            SemanticProperties.Hint="Opens the published video in an app or browser" />
                    <Button Text="{Binding WatchedActionLabel}" Command="{Binding ToggleWatchedCommand}"
                            Style="{StaticResource ConferenceSecondaryAction}" AutomationId="session-toggle-watched"
                            SemanticProperties.Hint="Updates your watched status on this device" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="12">
                    <Label Text="About this session" Style="{StaticResource Subheading}" />
                    <Label Text="{Binding Description}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasResources}">
                    <Label Text="Resources" Style="{StaticResource Subheading}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Resources}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConferenceLinkViewModel">
                                <controls:ConferenceLinkRow />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Speakers" Style="{StaticResource Subheading}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Speakers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpeakerViewModel">
                                <controls:SpeakerRow />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    <controls:TextScaleMonitor x:Name="ScaleMonitor" />
    </Grid>
</ContentView>
