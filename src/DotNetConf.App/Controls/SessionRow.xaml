<controls:DetailRow x:Class="DotNetConf.App.Controls.SessionRow"
             x:Name="DetailRowRoot"
             xmlns:controls="clr-namespace:DotNetConf.App.Controls"
             xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
             x:DataType="vm:SessionViewModel">
    <SwipeView x:Name="SessionSwipe" AutomationId="{Binding AutomationId, StringFormat='{0}-swipe'}">
        <SwipeView.LeftItems>
            <SwipeItems Mode="Execute" SwipeBehaviorOnInvoked="Close">
                <SwipeItemView Command="{Binding ToggleSaveCommand}"
                               AutomationId="{Binding AutomationId, StringFormat='{0}-save-swipe'}"
                               SemanticProperties.Description="{Binding SaveHint}"
                               BackgroundColor="{StaticResource Purple}">
                    <Grid WidthRequest="{Binding Source={x:Reference SessionSwipe}, Path=Width, x:DataType=SwipeView}"
                          Padding="16,12" BackgroundColor="{StaticResource Purple}"
                          AutomationProperties.ExcludedWithChildren="True">
                        <VerticalStackLayout Spacing="8" WidthRequest="144" HorizontalOptions="Start" VerticalOptions="Center">
                            <Label x:Name="SaveSwipeIcon" Text="{Binding SaveGlyph}" FontFamily="{Binding SaveFontFamily}" FontSize="28"
                                   HorizontalOptions="Center" HorizontalTextAlignment="Center"
                                   TextColor="{StaticResource White}" />
                            <Label Text="{Binding SaveSwipeInstruction}" FontFamily="OpenSansSemibold" FontSize="13"
                                   AutomationId="{Binding AutomationId, StringFormat='{0}-save-swipe-instruction'}"
                                   HorizontalTextAlignment="Center" LineBreakMode="WordWrap"
                                   TextColor="{StaticResource White}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsSaveSwipeReady, x:DataType=controls:SessionRow}"
                                                 Value="True">
                                        <Setter Property="Text" Value="{Binding SaveSwipeReleaseInstruction}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </VerticalStackLayout>
                    </Grid>
                </SwipeItemView>
            </SwipeItems>
        </SwipeView.LeftItems>
        <SwipeView.RightItems>
            <SwipeItems Mode="Reveal" SwipeBehaviorOnInvoked="Close">
                <SwipeItemView Command="{Binding QuickActionsCommand}"
                               AutomationId="{Binding AutomationId, StringFormat='{0}-more-swipe'}"
                               SemanticProperties.Description="{Binding QuickActionsDescription}"
                               BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                    <Grid WidthRequest="96" Padding="8,12" AutomationProperties.ExcludedWithChildren="True">
                        <Border Padding="8,12" MinimumHeightRequest="76" VerticalOptions="Center"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                Background="{AppThemeBinding Light={StaticResource LightSelectedSurface}, Dark={StaticResource DarkSelectedSurface}}">
                            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                <Image Source="{StaticResource MoreIcon}" WidthRequest="22" HeightRequest="22"
                                       HorizontalOptions="Center" />
                                <Label Text="More" FontFamily="OpenSansSemibold" FontSize="12"
                                       HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </SwipeItemView>
                <SwipeItemView Command="{Binding ToggleWatchedCommand}" IsVisible="{Binding HasWatchActions}"
                               AutomationId="{Binding AutomationId, StringFormat='{0}-watched-swipe'}"
                               SemanticProperties.Description="{Binding WatchedActionLabel}"
                               BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                    <Grid WidthRequest="96" Padding="8,12" AutomationProperties.ExcludedWithChildren="True">
                        <Border Padding="8,12" MinimumHeightRequest="76" VerticalOptions="Center"
                                StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                Background="{AppThemeBinding Light={StaticResource LightSelectedSurface}, Dark={StaticResource DarkSelectedSurface}}">
                            <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                                <Image WidthRequest="22" HeightRequest="22" HorizontalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="{Binding WatchedGlyph}" FontFamily="{Binding WatchedFontFamily}" Size="22"
                                                         Color="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                                    </Image.Source>
                                </Image>
                                <Label Text="{Binding WatchedSwipeLabel}" FontFamily="OpenSansSemibold" FontSize="12"
                                       HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </SwipeItemView>
            </SwipeItems>
        </SwipeView.RightItems>
    <VerticalStackLayout Spacing="0" Padding="0,16,0,0"
                         AutomationId="{Binding AutomationId, StringFormat='{0}-foreground'}"
                         BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
        <VerticalStackLayout.Triggers>
            <MultiTrigger TargetType="VerticalStackLayout">
                <MultiTrigger.Conditions>
                    <BindingCondition Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsSelected, x:DataType=controls:SessionRow}" Value="True" />
                    <BindingCondition Binding="{Binding Source={x:Reference DetailRowRoot}, Path=ShowsSelectionSurface, x:DataType=controls:SessionRow}" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource LightSelectedSurface}, Dark={StaticResource DarkSelectedSurface}}" />
            </MultiTrigger>
            <DataTrigger TargetType="VerticalStackLayout"
                         Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsCompactSearch, x:DataType=controls:SessionRow}" Value="True">
                <Setter Property="Padding" Value="0,4,0,0" />
            </DataTrigger>
        </VerticalStackLayout.Triggers>
        <Grid x:Name="RowActions" ColumnDefinitions="*,48,48" ColumnSpacing="4" Padding="0,0,0,20">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid"
                             Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsCompactSearch, x:DataType=controls:SessionRow}" Value="True">
                    <Setter Property="Padding" Value="0,0,0,4" />
                </DataTrigger>
            </Grid.Triggers>
            <Grid>
            <VerticalStackLayout Spacing="6" MinimumHeightRequest="48" InputTransparent="True"
                                 AutomationProperties.ExcludedWithChildren="True">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout"
                                 Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsCompactSearch, x:DataType=controls:SessionRow}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>
                <Label Text="{Binding DateLabel}" Style="{StaticResource Secondary}" FontSize="13" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{Binding TimeLabel}" FontFamily="OpenSansSemibold" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                    <controls:LiveIndicator Grid.Column="1" IsVisible="{Binding IsLive}" />
                </Grid>
                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="18"
                       TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource White}}" />
                <Label Text="{Binding SpeakerNames}" Style="{StaticResource Secondary}" FontSize="14" />
                <Label Text="{Binding TopicLabel}" Style="{StaticResource Secondary}" FontSize="13" />
                <Grid ColumnDefinitions="18,*" ColumnSpacing="6" IsVisible="{Binding HasVideoStatus}">
                    <Image Source="{StaticResource WatchPartyIcon}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding VideoStatusLabel}" FontSize="13" FontFamily="OpenSansSemibold"
                           TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                </Grid>
                <Label Text="No longer in the published agenda" IsVisible="{Binding IsWithdrawn}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}" />
                <Label Text="Overlaps another saved session" IsVisible="{Binding HasConflict}" FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource LightError}, Dark={StaticResource DarkError}}" />
            </VerticalStackLayout>
                <VerticalStackLayout Spacing="2" MinimumHeightRequest="48" InputTransparent="True"
                                     IsVisible="{Binding Source={x:Reference DetailRowRoot}, Path=IsCompactSearch, x:DataType=controls:SessionRow}"
                                     AutomationProperties.ExcludedWithChildren="True">
                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16"
                           MaxLines="2" LineBreakMode="TailTruncation"
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource White}}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Style="{StaticResource Secondary}" FontSize="12">
                            <Label.Text>
                                <MultiBinding StringFormat="{}{0}  {1}">
                                    <Binding Path="DateLabel" />
                                    <Binding Path="TimeLabel" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <controls:LiveIndicator Grid.Column="1" IsVisible="{Binding IsLive}" />
                    </Grid>
                </VerticalStackLayout>
                <Button Command="{Binding OpenCommand}" BackgroundColor="Transparent" BorderWidth="0"
                        AutomationId="{Binding AutomationId}" SemanticProperties.Hint="Opens session details. Touch and hold for quick actions.">
                    <Button.GestureRecognizers>
                        <LongPressGestureRecognizer MinimumPressDuration="600" Command="{Binding QuickActionsCommand}" />
                    </Button.GestureRecognizers>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsCompactSearch, x:DataType=controls:DetailRow}" Value="True">
                            <Setter Property="AutomationId" Value="{Binding AutomationId, StringFormat='compact-{0}'}" />
                        </DataTrigger>
                    </Button.Triggers>
                    <Button.SemanticProperties.Description>
                        <MultiBinding StringFormat="{}{0}{1}">
                            <Binding Path="NavigationDescription" />
                            <Binding Source="{x:Reference DetailRowRoot}" Path="SelectionSuffix" x:DataType="controls:DetailRow" />
                        </MultiBinding>
                    </Button.SemanticProperties.Description>
                </Button>
            </Grid>
            <controls:FavoriteButton Grid.Column="1"
                         VerticalOptions="Start" Margin="0,22,0,0"
                         ButtonAutomationId="{Binding SaveAutomationId}">
                <controls:FavoriteButton.Triggers>
                    <DataTrigger TargetType="controls:FavoriteButton"
                                 Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsCompactSearch, x:DataType=controls:SessionRow}" Value="True">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="ButtonAutomationId" Value="{Binding SaveAutomationId, StringFormat='compact-{0}'}" />
                    </DataTrigger>
                </controls:FavoriteButton.Triggers>
            </controls:FavoriteButton>
            <ImageButton x:Name="MoreButton" Grid.Column="2" Command="{Binding QuickActionsCommand}" Source="{StaticResource MoreIcon}"
                         Style="{StaticResource IconButton}" VerticalOptions="Start" Margin="0,22,0,0"
                         AutomationId="{Binding AutomationId, StringFormat='{0}-actions'}"
                         SemanticProperties.Description="{Binding QuickActionsDescription}"
                         SemanticProperties.Hint="Save, change watched status, or share this session">
                <ImageButton.Triggers>
                    <DataTrigger TargetType="ImageButton"
                                 Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsCompactSearch, x:DataType=controls:SessionRow}" Value="True">
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="AutomationId" Value="{Binding AutomationId, StringFormat='compact-{0}-actions'}" />
                    </DataTrigger>
                </ImageButton.Triggers>
            </ImageButton>
        </Grid>
        <BoxView HeightRequest="1">
            <BoxView.Triggers>
                <DataTrigger TargetType="BoxView" Binding="{Binding Source={x:Reference DetailRowRoot}, Path=IsSelected, x:DataType=controls:DetailRow}" Value="True">
                    <Setter Property="Opacity" Value="0" />
                </DataTrigger>
            </BoxView.Triggers>
        </BoxView>
    </VerticalStackLayout>
    </SwipeView>
</controls:DetailRow>
