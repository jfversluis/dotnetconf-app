<pages:ConferencePage x:Class="DotNetConf.App.Pages.AboutPage"
                      xmlns:pages="clr-namespace:DotNetConf.App.Pages"
                      xmlns:controls="clr-namespace:DotNetConf.App.Controls"
                      xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
                      x:DataType="vm:ConferenceViewModel" Title="About">
    <Grid SafeAreaEdges="Container,None,Container,None">
    <ScrollView SafeAreaEdges="Default" AutomationId="about-scroll">
        <VerticalStackLayout Padding="24" Spacing="24" MaximumWidthRequest="720" HorizontalOptions="Center" SafeAreaEdges="None">
            <Label Text="A celebration of .NET" Style="{StaticResource Heading}" />
            <Label Text="{Binding ConferenceDescription}" />
            <Label Text="Sessions and speaker details come from Microsoft's public .NET Conf agenda."
                   Style="{StaticResource Secondary}" AutomationId="agenda-source-disclosure" />
            <VerticalStackLayout Spacing="8">
                <Label Text="Refresh the agenda" Style="{StaticResource Subheading}" />
                <Label Text="Pull down on Home, Sessions, Speakers, or the List view in My Schedule to check for updates. If an update fails, choose Retry. Downloaded sessions stay available offline."
                       Style="{StaticResource Secondary}" AutomationId="refresh-help" />
                <Button Text="Check for agenda updates" Command="{Binding RequestRefreshCommand}"
                        IsEnabled="{Binding CanRefresh}" Style="{StaticResource QuietButton}"
                        AutomationId="about-refresh"
                        SemanticProperties.Hint="An alternative to pulling down on an agenda screen." />
            </VerticalStackLayout>
            <Label Text="Community events and venues are fictional examples, not confirmed gatherings."
                   IsVisible="{Binding CommunityEventsAreMock}" Style="{StaticResource Secondary}" />
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsMock}">
                <Label Text="About the sample agenda" Style="{StaticResource Subheading}" />
                <Label Text="All talks and participation in this preview are fictional examples. Some real .NET community names are used for demo purposes only, not as announced or endorsed participants."
                       Style="{StaticResource Secondary}" AutomationId="mock-data-disclosure" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="12">
                <Label Text="A community companion" Style="{StaticResource Subheading}" />
                <Label Text="Discover sessions, meet the speakers, and build your personal .NET Conf schedule."
                       Style="{StaticResource Secondary}" />
                <Label Text="For confirmed dates, registration, and announcements, use the official website."
                       Style="{StaticResource Secondary}" />
                <Button Text="Visit the official website" Command="{Binding OpenWebsiteCommand}"
                        Style="{StaticResource QuietButton}" ImageSource="{StaticResource WebsiteIcon}" AutomationId="about-website" />
                <Button Text="Explore community events" Command="{Binding BrowseCommunityEventsCommand}"
                        Style="{StaticResource QuietButton}" ImageSource="{StaticResource CommunityIcon}" AutomationId="about-community" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <VerticalStackLayout Spacing="12">
                <Label Text="Your schedule stays here" Style="{StaticResource Subheading}" />
                <Label Text="Your saved schedule, watched status, and preferences stay on this device. Your device's backup may include them. Links open in another app or browser, where its privacy policy applies."
                       Style="{StaticResource Secondary}" />
                <Button Text="Privacy policy" Clicked="OnPrivacyClicked" Style="{StaticResource QuietButton}"
                        AutomationId="about-privacy" SemanticProperties.Hint="Read this version's policy offline." />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="12">
                <Label Text="Acknowledgments" Style="{StaticResource Subheading}" />
                <Label Text="This app includes open-source software, icons, and fonts. Their notices and licenses are available here."
                       Style="{StaticResource Secondary}" />
                <Button Text="Third-party dependencies" ImageSource="{StaticResource AboutIcon}"
                        Style="{StaticResource QuietButton}" Clicked="OnDependenciesClicked"
                        AutomationId="about-dependencies" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</pages:ConferencePage>
