<ContentPage x:Class="DotNetConf.App.Pages.CommunityEventsPage"
             x:Name="EventPage"
             xmlns:pages="clr-namespace:DotNetConf.App.Pages"
             xmlns:controls="clr-namespace:DotNetConf.App.Controls"
             xmlns:sheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
             xmlns:core="clr-namespace:DotNetConf.Core;assembly=DotNetConf.Core"
             x:DataType="pages:CommunityEventsPage"
             Title="{Binding ExplorerTitle}" SafeAreaEdges="None" Shell.TabBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="ExplorerModeButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
    </ContentPage.Resources>
    <!-- Operate: the map is the canvas, not an illustration in a card. Native chrome and
         purple/magenta Fluent pins extend the existing identity. Zoom clusters, select a
         location, then read its preview in the shared bottom-sheet presentation. -->
    <sheet:SfBottomSheet x:Name="EventSheet" IsModal="True" State="Hidden" AllowedState="FullExpanded"
                        FullExpandedRatio="0.6" CornerRadius="28,28,0,0" CollapseOnOverlayTap="True"
                        Background="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                        GrabberBackground="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"
                        SwipeFromHeaderOnly="True" StateChanged="OnEventSheetStateChanged">
    <sheet:SfBottomSheet.Content>
    <Grid RowDefinitions="Auto,*" SafeAreaEdges="None">
        <Grid Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}"
              SafeAreaEdges="Container" IsVisible="{Binding IsCompact}">
            <VerticalStackLayout Padding="24,16,24,18" Spacing="6">
                <Label Text="Find your people." FontFamily="SpaceGroteskBold" FontSize="28"
                       TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource White}}"
                       SemanticProperties.HeadingLevel="Level1" IsVisible="{Binding ShowExplorerHeadline}"
                       AutomationId="community-explorer-title" />
                <Grid x:Name="HeaderControls" ColumnDefinitions="*,Auto" RowDefinitions="Auto,0"
                      ColumnSpacing="12" AutomationId="community-header-controls">
                    <Label x:Name="LocationCount" Text="{Binding LocationSummary}" FontFamily="OpenSansSemibold" FontSize="14"
                           IsVisible="{Binding Conference.HasCommunityEvents}" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}"
                           AutomationId="community-location-count" />
                    <Grid Grid.Column="1" x:Name="ModeSwitch" HorizontalOptions="Start"
                          IsVisible="{Binding ShowModeControls}" AutomationId="community-view-switch">
                        <Border StrokeShape="RoundRectangle 27"
                                Stroke="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
                        <HorizontalStackLayout Spacing="2" Padding="3">
                            <Button Text="Map" Clicked="OnMapClicked" Style="{StaticResource ExplorerModeButton}"
                                    AutomationId="community-map-mode" SemanticProperties.Description="{Binding MapModeDescription}"
                                    SemanticProperties.Hint="Explore clustered event locations on the map">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding ShowMap}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Midnight}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button Text="List" Clicked="OnListClicked" Style="{StaticResource ExplorerModeButton}"
                                    AutomationId="community-list-mode" SemanticProperties.Description="{Binding ListModeDescription}"
                                    SemanticProperties.Hint="Browse the same events without using the map">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding ShowList}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Midnight}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </Grid>
        <Grid Grid.Row="1" x:Name="Panes" RowDefinitions="*,0,0,Auto" ColumnDefinitions="*,0,0"
              RowSpacing="0" ColumnSpacing="0" SafeAreaEdges="None"
              AutomationId="community-explorer-panes">
        <Grid x:Name="MapPane" IsVisible="{Binding ShowMap}" SafeAreaEdges="None"
              AutomationId="community-map-pane">
        <Grid x:Name="MapHost" SafeAreaEdges="None"
              AutomationId="community-map-host" />
        <Grid RowDefinitions="Auto,*" SafeAreaEdges="Container" InputTransparent="True" CascadeInputTransparent="False">
            <Border Margin="16" Padding="14,10" StrokeShape="RoundRectangle 20" StrokeThickness="0"
                    HorizontalOptions="Center" VerticalOptions="Start" IsVisible="{Binding ShowMap}"
                    InputTransparent="True"
                    AutomationId="community-map-legend"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,3" Radius="10" Opacity="0.16" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="4">
                    <FlexLayout Wrap="Wrap" JustifyContent="Center" AlignItems="Center">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,0,12,0">
                            <Image Source="{Binding WatchPartyPin}" WidthRequest="18" HeightRequest="24"
                                   VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1" Text="Watch party" FontSize="14" VerticalOptions="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                            <Image Source="{Binding InPersonPin}" WidthRequest="18" HeightRequest="24"
                                   VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                            <Label Grid.Column="1" Text="In-person talks" FontSize="14" VerticalOptions="Center" />
                        </Grid>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
            <ImageButton Grid.Row="1" Source="{StaticResource ShowAllIcon}" Clicked="OnShowAllClicked"
                         Style="{StaticResource IconButton}" Margin="16,0,16,16"
                         HorizontalOptions="End" VerticalOptions="Start"
                         BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                         BorderColor="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                         BorderWidth="1" AutomationId="community-show-all"
                         SemanticProperties.Description="Show all locations"
                         SemanticProperties.Hint="Reset the map to the worldwide overview; pan to explore other regions">
                <ImageButton.Shadow>
                    <Shadow Brush="Black" Offset="0,3" Radius="10" Opacity="0.16" />
                </ImageButton.Shadow>
            </ImageButton>
        </Grid>
        </Grid>
            <Grid x:Name="ListPane" RowDefinitions="Auto,*" IsVisible="{Binding ShowList}" SafeAreaEdges="Container"
                  BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkBackground}}"
                  AutomationId="community-list-pane">
                <VerticalStackLayout Padding="24,20,24,12" Spacing="10">
                    <Label Text="Find your people." FontFamily="SpaceGroteskBold" FontSize="28"
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource White}}"
                           SemanticProperties.HeadingLevel="Level1" IsVisible="{Binding IsSplit}" />
                    <Label Text="{Binding LocationSummary}" FontFamily="OpenSansSemibold" FontSize="14"
                           IsVisible="{Binding IsSplit}"
                           TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                    <Label Text="Find a gathering" Style="{StaticResource Subheading}" IsVisible="{Binding IsCompact}" />
                    <Label Text="{Binding ListHelp}" Style="{StaticResource Secondary}" FontSize="14"
                           AutomationId="community-map-help" />
                    <controls:StatusBanner BindingContext="{Binding Conference}" />
                </VerticalStackLayout>
                <CollectionView Grid.Row="1" ItemsSource="{Binding Conference.CommunityEvents}" SelectionMode="Single"
                                SelectedItem="{Binding SelectedEvent, Mode=TwoWay}" AutomationId="community-event-list">
                    <CollectionView.Footer>
                        <controls:SafeAreaFooter Page="{x:Reference EventPage}" AutomationId="community-safe-area-footer" />
                    </CollectionView.Footer>
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="24" Spacing="12">
                            <HorizontalStackLayout Spacing="12" IsVisible="{Binding Conference.IsCommunityEventsLoading}">
                                <ActivityIndicator IsRunning="{Binding Conference.IsCommunityEventsLoading}"
                                                   WidthRequest="24" AutomationId="community-events-loading" />
                                <Label Text="Loading community listings…" Style="{StaticResource Secondary}" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout.Triggers>
                                    <DataTrigger TargetType="VerticalStackLayout"
                                                 Binding="{Binding Conference.IsCommunityEventsLoading}" Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </VerticalStackLayout.Triggers>
                            <Label Text="No community events are listed here yet. Visit the official website for current gatherings."
                                   Style="{StaticResource Secondary}" AutomationId="community-events-empty" />
                            <Button Text="Visit dot.net/conf" Command="{Binding Conference.OpenWebsiteCommand}"
                                    Style="{StaticResource QuietButton}" ImageSource="{StaticResource WebsiteIcon}"
                                    AutomationId="community-events-website" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="core:CommunityEvent">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="Transparent" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource LavenderLight}, Dark={StaticResource DarkSurface}}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <VerticalStackLayout Padding="24,16" Spacing="6" InputTransparent="True"
                                                     AutomationProperties.ExcludedWithChildren="True">
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding KindLabel}" FontSize="14" Style="{StaticResource Secondary}" />
                                    <Label Text="{Binding LocationLabel}" FontSize="14" Style="{StaticResource Secondary}" />
                                    <BoxView HeightRequest="1" Margin="0,8,0,0" />
                                </VerticalStackLayout>
                                <Button Command="{Binding SelectEventCommand, Source={x:Reference EventPage}, x:DataType=pages:CommunityEventsPage}"
                                        CommandParameter="{Binding .}" BackgroundColor="Transparent" BorderWidth="0"
                                        AutomationId="{Binding Id}" SemanticProperties.Description="{Binding AccessibilityLabel}"
                                        SemanticProperties.Hint="Select this event for a preview" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </Grid>
    </sheet:SfBottomSheet.Content>
    <sheet:SfBottomSheet.BottomSheetContent>
            <ScrollView AutomationId="community-event-preview">
                <ScrollView.SafeAreaEdges>
                    <OnPlatform x:TypeArguments="SafeAreaEdges" Default="Container,Container,Container,All">
                        <On Platform="Android" Value="Container,Container,Container,None" />
                    </OnPlatform>
                </ScrollView.SafeAreaEdges>
                <VerticalStackLayout Padding="24,12,24,16" Spacing="6">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Image Source="{Binding SelectedPin}" WidthRequest="36" HeightRequest="46"
                               VerticalOptions="Center" AutomationProperties.IsInAccessibleTree="False" />
                        <Label Grid.Column="1" Text="{Binding SelectedLocation}" FontFamily="SpaceGroteskBold" FontSize="21"
                               VerticalOptions="Center"
                               AutomationId="community-selected-name" />
                        <ImageButton Grid.Column="2" Source="{StaticResource ClearIcon}" Style="{StaticResource IconButton}"
                                     Clicked="OnDismissClicked" SemanticProperties.Description="Dismiss event preview"
                                     AutomationId="community-dismiss" />
                    </Grid>
                    <Label Text="{Binding SelectedEvent.KindLabel}" FontSize="14" Style="{StaticResource Secondary}" />
                    <Label Text="{Binding SelectedEvent.Name}" FontSize="14" Style="{StaticResource Secondary}" />
                    <Button Text="Event details" Clicked="OnEventDetailsClicked" Style="{StaticResource QuietButton}"
                            AutomationId="community-event-details" />
                </VerticalStackLayout>
            </ScrollView>
    </sheet:SfBottomSheet.BottomSheetContent>
    </sheet:SfBottomSheet>
</ContentPage>
