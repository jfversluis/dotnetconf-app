<pages:ConferencePage x:Class="DotNetConf.App.Pages.CommunityPage"
                      x:Name="OverviewPage"
                      xmlns:pages="clr-namespace:DotNetConf.App.Pages"
                      xmlns:controls="clr-namespace:DotNetConf.App.Controls"
                      xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
                      x:DataType="vm:ConferenceViewModel" Title="Community">
    <Grid SafeAreaEdges="None">
    <ScrollView SafeAreaEdges="None,None,None,Container" AutomationId="community-scroll">
        <VerticalStackLayout Spacing="0" HorizontalOptions="Fill" SafeAreaEdges="None">
            <Grid Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}"
                  SafeAreaEdges="None" AutomationId="community-hero">
                <controls:DuoSafeAreaContent AutomationId="community-hero-safe-content">
                <VerticalStackLayout Padding="24,28,24,24" Spacing="12" SafeAreaEdges="Container,None,Container,None"
                                     MaximumWidthRequest="720" HorizontalOptions="Center">
                    <Label Text="Great ideas.&#10;Better together." FontFamily="SpaceGroteskBold" FontSize="34"
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource White}}"
                           SemanticProperties.HeadingLevel="Level1" AutomationId="community-title" />
                    <Label Text="One conference. A worldwide community."
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource LavenderLight}}" />
                </VerticalStackLayout>
                </controls:DuoSafeAreaContent>
            </Grid>
            <controls:DuoSafeAreaContent AutomationId="community-body-safe-content">
            <VerticalStackLayout Padding="24,28,24,32" Spacing="28" SafeAreaEdges="Container,None,Container,None"
                                 MaximumWidthRequest="720" HorizontalOptions="Center">
                <controls:StatusBanner />
                <VerticalStackLayout Spacing="12">
                    <Label Text="Bring someone along" Style="{StaticResource Subheading}" />
                    <Label Text="A talk worth watching is even better with someone to talk about it with."
                           Style="{StaticResource Secondary}" />
                    <Button Text="{Binding ShareConferenceLabel}" Command="{Binding ShareConferenceCommand}"
                            Style="{StaticResource ConferenceAction}" AutomationId="community-share"
                            SemanticProperties.Hint="{Binding ShareConferenceHint}" />
                    <Button Text="Register for .NET Conf" Command="{Binding OpenRegistrationCommand}"
                            Style="{StaticResource ConferenceSecondaryAction}" AutomationId="community-register"
                            SemanticProperties.Hint="Opens Microsoft Reactor registration in your browser" />
                </VerticalStackLayout>
                <BoxView HeightRequest="1" />
                <VerticalStackLayout Spacing="12">
                    <Label Text="Join the conversation" Style="{StaticResource Subheading}" />
                    <Label Text="What are you building next? Follow .NET and share your conference discoveries."
                           Style="{StaticResource Secondary}" />
                    <Label Text="#dotnetconf" FontFamily="SpaceGroteskBold" FontSize="28"
                           TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}"
                           AutomationId="community-hashtag" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SocialChannels}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConferenceLinkViewModel">
                                <controls:ConferenceLinkRow />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <BoxView HeightRequest="1" />
                <VerticalStackLayout Spacing="12">
                    <Label Text="Meet locally" Style="{StaticResource Subheading}" />
                    <HorizontalStackLayout Spacing="12" IsVisible="{Binding IsCommunityEventsLoading}">
                        <ActivityIndicator IsRunning="{Binding IsCommunityEventsLoading}" WidthRequest="24"
                                           AutomationId="community-events-loading" />
                        <Label Text="Checking community events" Style="{StaticResource Secondary}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding CommunityEventSummary}" IsVisible="{Binding IsCommunityEventsEmpty}"
                           Style="{StaticResource Secondary}" AutomationId="community-events-overview-empty" />
                    <Label Text="{Binding CommunityEventSummary}" IsVisible="{Binding HasCommunityEvents}"
                           Style="{StaticResource Secondary}" AutomationId="community-event-summary" />
                    <Label Text="These events are fictional examples, not confirmed gatherings."
                           IsVisible="{Binding HasMockCommunityEvents}" Style="{StaticResource Secondary}" FontSize="14"
                           AutomationId="community-overview-disclosure" />
                    <Button Text="Browse community events" ImageSource="{StaticResource EventListIcon}"
                            Command="{Binding BrowseCommunityListCommand}" IsVisible="{Binding HasCommunityEvents}"
                            Style="{StaticResource ConferenceSecondaryAction}" AutomationId="community-browse-events"
                            SemanticProperties.Hint="Opens the event list, with a map when available" />
                    <Button Text="Explore the world map" ImageSource="{StaticResource MapIcon}"
                            Command="{Binding ExploreCommunityMapCommand}" IsVisible="{Binding HasCommunityEvents}"
                            Style="{StaticResource ConferenceAction}" AutomationId="community-explore-map"
                            SemanticProperties.Hint="Explore clustered locations. Debug builds show fictional demo events." />
                </VerticalStackLayout>
                <BoxView HeightRequest="1" />
                <VerticalStackLayout Spacing="12">
                    <Label Text="Make it local" Style="{StaticResource Subheading}" />
                    <Label Text="Thinking about bringing people together? Start with a local developer group, choose a format, and keep an eye on the official .NET Conf website for announcements."
                           Style="{StaticResource Secondary}" />
                    <Button Text="Visit .NET Conf" Command="{Binding OpenWebsiteCommand}"
                            Style="{StaticResource QuietButton}" ImageSource="{StaticResource WebsiteIcon}"
                            AutomationId="community-official-website"
                            SemanticProperties.Hint="Opens the official conference site in your browser" />
                </VerticalStackLayout>
            </VerticalStackLayout>
            </controls:DuoSafeAreaContent>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</pages:ConferencePage>
