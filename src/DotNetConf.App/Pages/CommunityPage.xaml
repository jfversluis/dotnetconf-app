<pages:ConferencePage x:Class="DotNetConf.App.Pages.CommunityPage"
                      x:Name="OverviewPage"
                      xmlns:pages="clr-namespace:DotNetConf.App.Pages"
                      xmlns:controls="clr-namespace:DotNetConf.App.Controls"
                      xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
                      x:DataType="vm:ConferenceViewModel" Title="Community">
    <ScrollView SafeAreaEdges="Default" AutomationId="community-scroll">
        <VerticalStackLayout Spacing="0" MaximumWidthRequest="720" HorizontalOptions="Center" SafeAreaEdges="None">
            <Grid Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}"
                  SafeAreaEdges="None">
                <VerticalStackLayout Padding="24,32,24,28" Spacing="16" SafeAreaEdges="None">
                    <Label Text="Great ideas.&#10;Better together." FontFamily="SpaceGroteskBold" FontSize="34"
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource White}}"
                           SemanticProperties.HeadingLevel="Level1" AutomationId="community-title" />
                    <Label Text="Bring .NET Conf to your community. Watch the stream together, meet local developers, and put new ideas into practice."
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource LavenderLight}}" />
                    <Label Text="Explore fictional events for now. Real community events haven't been announced here yet."
                           IsVisible="{Binding IsMock}" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource LavenderLight}}"
                           AutomationId="community-overview-disclosure" />
                    <Button Text="Explore event map" ImageSource="{StaticResource PrimaryMapIcon}"
                            Command="{Binding ExploreCommunityMapCommand}" AutomationId="community-explore-map">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Value="False"
                                         Binding="{Binding HasMapConfiguration, Source={x:Reference OverviewPage}, x:DataType=pages:CommunityPage}">
                                <Setter Property="Text" Value="Browse community events" />
                                <Setter Property="ImageSource" Value="{StaticResource PrimaryEventListIcon}" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Grid>
            <VerticalStackLayout Padding="24,28,24,32" Spacing="28" SafeAreaEdges="None">
                <controls:StatusBanner />
                <VerticalStackLayout Spacing="20">
                    <Label Text="Find your kind of gathering" Style="{StaticResource Subheading}" />
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="12">
                        <Image Source="{StaticResource WatchPartyIcon}" WidthRequest="28" HeightRequest="28"
                               VerticalOptions="Start" AutomationProperties.IsInAccessibleTree="False" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Watch together" FontFamily="OpenSansSemibold" />
                            <Label Text="A shared screen, a few familiar faces, and a conversation about what's next. Watch parties follow the .NET Conf broadcast."
                                   Style="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="32,*" ColumnSpacing="12">
                        <Image Source="{StaticResource InPersonIcon}" WidthRequest="28" HeightRequest="28"
                               VerticalOptions="Start" AutomationProperties.IsInAccessibleTree="False" />
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Meet local presenters" FontFamily="OpenSansSemibold" />
                            <Label Text="Go beyond the stream with in-person talks and demos. Local presenters share the latest .NET Conf materials with their community."
                                   Style="{StaticResource Secondary}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
                <BoxView HeightRequest="1" />
                <VerticalStackLayout Spacing="12">
                    <Label Text="A place to connect" Style="{StaticResource Subheading}" />
                    <Label Text="{Binding CommunityEventSummary}" Style="{StaticResource Secondary}"
                           AutomationId="community-event-summary" />
                    <Button Text="Browse event list" Command="{Binding BrowseCommunityListCommand}"
                            Style="{StaticResource QuietButton}" ImageSource="{StaticResource EventListIcon}"
                            AutomationId="community-browse-list" />
                    <Label Text="The list works without map tiles or location access. Event websites have the details you need before attending."
                           Style="{StaticResource Secondary}" FontSize="14" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="12">
                    <Label Text="Make it local" Style="{StaticResource Subheading}" />
                    <Label Text="Thinking about bringing people together? Start with a local developer group, choose a format, and keep an eye on the official .NET Conf website for announcements."
                           Style="{StaticResource Secondary}" />
                    <Button Text="Visit .NET Conf" Command="{Binding OpenWebsiteCommand}"
                            Style="{StaticResource QuietButton}" ImageSource="{StaticResource WebsiteIcon}"
                            AutomationId="community-official-website" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</pages:ConferencePage>
