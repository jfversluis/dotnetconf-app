<pages:ConferencePage x:Class="DotNetConf.App.Pages.HomePage"
                      xmlns:pages="clr-namespace:DotNetConf.App.Pages"
                      xmlns:controls="clr-namespace:DotNetConf.App.Controls"
                      xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
                      xmlns:sheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
                      x:DataType="vm:ConferenceViewModel" Title=".NET Conf">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Settings" IconImageSource="{StaticResource SettingsIcon}"
                     Command="{Binding BrowseSettingsCommand}" AutomationId="home-settings" />
    </ContentPage.ToolbarItems>
    <sheet:SfBottomSheet x:Name="AskSheet" IsModal="True" State="Hidden" AllowedState="FullExpanded"
                         FullExpandedRatio="0.94" CornerRadius="28,28,0,0" CollapseOnOverlayTap="False"
                         Background="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                         GrabberBackground="{AppThemeBinding Light={StaticResource LightSecondary}, Dark={StaticResource DarkSecondary}}"
                         SwipeFromHeaderOnly="True" StateChanged="AskStateChanged">
    <sheet:SfBottomSheet.Content>
    <Grid SafeAreaEdges="None">
    <RefreshView IsRefreshing="{Binding IsPullRefreshing, Mode=TwoWay}"
                 Command="{Binding RequestRefreshCommand}"
                 RefreshColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}"
                 AutomationId="home-refresh">
    <ScrollView SafeAreaEdges="None,None,None,Container" AutomationId="home-scroll">
        <VerticalStackLayout Spacing="0" HorizontalOptions="Fill" SafeAreaEdges="None">
            <Grid Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}"
                  SafeAreaEdges="None" AutomationId="home-hero">
                <controls:DuoSafeAreaContent AutomationId="home-hero-safe-content">
                <VerticalStackLayout Padding="24,32,24,28" Spacing="16" SafeAreaEdges="Container,None,Container,None"
                                     MaximumWidthRequest="720" HorizontalOptions="Center">
                    <Label Text="{Binding ConferenceName}" FontFamily="SpaceGroteskBold" FontSize="40"
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource White}}"
                           SemanticProperties.HeadingLevel="Level1" AutomationId="home-title" />
                    <Border HeightRequest="4" WidthRequest="72" HorizontalOptions="Start" StrokeThickness="0"
                            Background="{AppThemeBinding Light={StaticResource ConferenceGradient}, Dark={StaticResource ConferenceDarkGradient}}" />
                    <Label Text="{Binding ConferenceDateContext}" IsVisible="{Binding HasConferenceDates}"
                           FontFamily="OpenSansSemibold" AutomationId="home-conference-dates"
                           TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource LavenderLight}}" />
                    <Label Text="Find your sessions, make a schedule, and join the .NET community online."
                           TextColor="{AppThemeBinding Light={StaticResource Midnight}, Dark={StaticResource LavenderLight}}" />
                    <Button x:Name="BrowseSessions" Text="Browse sessions" Command="{Binding BrowseSessionsCommand}" AutomationId="home-sessions"
                            HorizontalOptions="Start" Padding="24,14" />
                    <Border x:Name="AskLauncher" Stroke="{AppThemeBinding Light={StaticResource ConferenceGradient}, Dark={StaticResource ConferenceDarkGradient}}"
                            StrokeThickness="1.5" StrokeShape="RoundRectangle 24" IsVisible="False"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                        <Border.Shadow>
                            <Shadow Brush="{StaticResource Magenta}" Offset="0,2" Radius="18" Opacity="0.25" />
                        </Border.Shadow>
                        <Button x:Name="AskLauncherButton" Text="Ask about the conference" ImageSource="{StaticResource ScheduleSparkleIcon}"
                                Clicked="OpenAskClicked" Style="{StaticResource QuietButton}" BorderWidth="0"
                                LineBreakMode="WordWrap" Padding="18,16" AutomationId="home-ask" />
                    </Border>
                </VerticalStackLayout>
                </controls:DuoSafeAreaContent>
            </Grid>
            <controls:DuoSafeAreaContent AutomationId="home-body-safe-content">
            <VerticalStackLayout Padding="24,24,24,32" Spacing="28" SafeAreaEdges="Container,None,Container,None"
                                 MaximumWidthRequest="720" HorizontalOptions="Center">
            <controls:StatusBanner />
            <HorizontalStackLayout Spacing="12" IsVisible="{Binding IsInitialAgendaLoading}">
                <ActivityIndicator IsRunning="{Binding IsInitialAgendaLoading}" WidthRequest="24"
                                   AutomationId="home-initial-loading" />
                <Label Text="Loading the agenda" Style="{StaticResource Secondary}" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <VerticalStackLayout Spacing="8" IsVisible="{Binding HasNextSavedSession}" AutomationId="home-next-session">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="Your schedule" Style="{StaticResource Subheading}" />
                    <Label Grid.Column="1" Text="{Binding NextSavedStatus}" FontFamily="OpenSansSemibold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}"
                           AutomationId="home-next-status">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding NextSavedSession.IsLive}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <controls:LiveIndicator Grid.Column="1" IsVisible="{Binding NextSavedSession.IsLive}" AutomationId="home-live" />
                </Grid>
                <VerticalStackLayout BindingContext="{Binding NextSavedSession}" x:DataType="vm:SessionViewModel" Spacing="4">
                    <Button Text="{Binding Title}" Command="{Binding OpenCommand}"
                            Style="{StaticResource ConferenceTextAction}" AutomationId="home-next-session-open"
                            SemanticProperties.Hint="Open the saved session details" />
                    <Label Text="{Binding DateLabel}" Style="{StaticResource Secondary}" />
                    <Label Text="{Binding TimeLabel}" Style="{StaticResource Secondary}" />
                </VerticalStackLayout>
                <Label Text="{Binding TimeZoneLabel}" Style="{StaticResource Secondary}" FontSize="12" />
                <Button Text="View My Schedule" Command="{Binding BrowseScheduleCommand}"
                        Style="{StaticResource QuietButton}" AutomationId="home-next-schedule" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="12">
                <Label Text="Join the conference" Style="{StaticResource Subheading}" />
                <Label Text="Find registration, event details, and viewing updates on the official .NET Conf site."
                       Style="{StaticResource Secondary}" />
                <Button Text="Register for .NET Conf" Command="{Binding OpenRegistrationCommand}"
                        Style="{StaticResource ConferenceSecondaryAction}" AutomationId="home-register"
                        SemanticProperties.Hint="Opens Microsoft Reactor registration in your browser" />
                <Button Text="Visit the conference site" Command="{Binding OpenWebsiteCommand}"
                        ImageSource="{StaticResource WebsiteIcon}" Style="{StaticResource ConferenceSecondaryAction}"
                        AutomationId="home-website" SemanticProperties.Hint="Opens the official conference site in your browser" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <VerticalStackLayout Spacing="12">
                <Label Text="Explore .NET Conf" Style="{StaticResource Subheading}" />
                <Label Text="Meet the people behind the talks and revisit your saved sessions."
                       Style="{StaticResource Secondary}" />
                <Button Text="Meet the speakers" Command="{Binding BrowseSpeakersCommand}"
                        Style="{StaticResource QuietButton}" ImageSource="{StaticResource SpeakersIcon}" AutomationId="home-speakers" />
                <Button Text="{Binding ScheduleSummary}" Command="{Binding BrowseScheduleCommand}"
                        Style="{StaticResource QuietButton}" ImageSource="{StaticResource ScheduleIcon}" AutomationId="home-schedule" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="8">
                <Label Text="From the community, for the community" Style="{StaticResource Subheading}" />
                <Label Text="Join the conversation, share the conference, or find a way to watch together."
                       Style="{StaticResource Secondary}" />
                <Button Text="Connect with the community" Command="{Binding BrowseCommunityEventsCommand}"
                        Style="{StaticResource QuietButton}" ImageSource="{StaticResource CommunityIcon}" AutomationId="home-community" />
            </VerticalStackLayout>
            </VerticalStackLayout>
            </controls:DuoSafeAreaContent>
        </VerticalStackLayout>
    </ScrollView>
    </RefreshView>
    </Grid>
    </sheet:SfBottomSheet.Content>
    <sheet:SfBottomSheet.BottomSheetContent>
        <controls:AskSheetView x:Name="AskContent" CloseRequested="CloseAskRequested"
                               ScheduleRequested="AskScheduleRequested" />
    </sheet:SfBottomSheet.BottomSheetContent>
    </sheet:SfBottomSheet>
</pages:ConferencePage>
