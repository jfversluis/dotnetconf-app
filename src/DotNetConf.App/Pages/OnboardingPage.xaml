<ContentPage x:Class="DotNetConf.App.Pages.OnboardingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:DotNetConf.App.Pages"
             x:DataType="pages:OnboardingPage"
             Shell.NavBarIsVisible="False" NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="{OnPlatform iOS='All,None,All,All', Android=All}" AutomationId="onboarding-page">
    <ContentPage.Resources>
        <Style x:Key="OnboardingHeading" TargetType="Label" BasedOn="{StaticResource Heading}">
            <Setter Property="FontSize" Value="34" />
        </Style>
        <Style x:Key="OnboardingLead" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <Style x:Key="OnboardingNext" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Style.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsReminderStep}" Value="True">
                    <Setter Property="BackgroundColor" Value="Transparent" />
                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}" />
                    <Setter Property="BorderWidth" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="WelcomeTemplate" x:DataType="pages:OnboardingPage">
            <ScrollView SafeAreaEdges="None" AutomationId="onboarding-welcome-scroll">
                <VerticalStackLayout Spacing="0" SafeAreaEdges="None">
                    <Grid SafeAreaEdges="None" Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}">
                        <VerticalStackLayout Padding="{Binding HeroPadding}" Spacing="24" MaximumWidthRequest="600"
                                             HorizontalOptions="Fill" SafeAreaEdges="None">
                            <Image Source="{StaticResource OnboardingAgendaIcon}" HeightRequest="48" WidthRequest="48"
                                   HorizontalOptions="Start" InputTransparent="True"
                                   AutomationProperties.IsInAccessibleTree="False" />
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Big ideas.&#10;Your kind of .NET." Style="{StaticResource OnboardingHeading}"
                                       AutomationId="onboarding-welcome" />
                                <Label Text="Find your next rabbit hole, save the talks you love, and make the conference your own."
                                       Style="{StaticResource OnboardingLead}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Padding="24,28,24,24" Spacing="24" MaximumWidthRequest="600"
                                         HorizontalOptions="Fill">
                        <Label Text="Start with a few interests. Our on-device session builder can turn them into a shortlist you review before saving." />
                        <Label Text="No account. No cloud AI. Just you and the agenda."
                               FontFamily="OpenSansSemibold" FontSize="14" />
                        <Label Text="Fictional demo agenda. Talks and participation are not announced or endorsed."
                               Style="{StaticResource Secondary}" FontSize="13" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
        <DataTemplate x:Key="RemindersTemplate" x:DataType="pages:OnboardingPage">
            <ScrollView SafeAreaEdges="None" AutomationId="onboarding-reminders-scroll">
                <VerticalStackLayout Spacing="0" SafeAreaEdges="None">
                    <Grid SafeAreaEdges="None" Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}">
                        <VerticalStackLayout Padding="{Binding HeroPadding}" Spacing="24" MaximumWidthRequest="600"
                                             HorizontalOptions="Fill" SafeAreaEdges="None">
                            <Image Source="{StaticResource ReminderIcon}" HeightRequest="48" WidthRequest="48"
                                   HorizontalOptions="Start" InputTransparent="True"
                                   AutomationProperties.IsInAccessibleTree="False" />
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Less clock-watching.&#10;More conference." Style="{StaticResource OnboardingHeading}"
                                       AutomationId="onboarding-reminders-title" />
                                <Label Text="Get a reminder when a session in My Schedule begins. We'll ask your device for notification permission only if you choose to enable it."
                                       Style="{StaticResource OnboardingLead}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Padding="24,28,24,24" Spacing="20" MaximumWidthRequest="600"
                                         HorizontalOptions="Fill">
                        <Label Text="Reminders stay on this device. No marketing messages, no account, and no push server. Your device controls delivery."
                               Style="{StaticResource Secondary}" FontSize="14" />
                        <VerticalStackLayout Spacing="12">
                            <Button Text="Enable session reminders" Clicked="EnableRemindersClicked" LineBreakMode="WordWrap"
                                    IsEnabled="{Binding CanRequestReminders}" AutomationId="onboarding-enable-reminders" />
                            <ActivityIndicator IsRunning="{Binding RequestingReminders}" IsVisible="{Binding RequestingReminders}"
                                               HorizontalOptions="Start" AutomationId="onboarding-reminders-loading"
                                               SemanticProperties.Description="Enabling session reminders" />
                            <Label Text="{Binding ReminderStatus}" IsVisible="{Binding ShowReminderStatus}"
                                   AutomationId="onboarding-reminder-status" SemanticProperties.Description="{Binding ReminderStatus}" />
                            <Button Text="Open notification settings" Style="{StaticResource QuietButton}" LineBreakMode="WordWrap"
                                    IsVisible="{Binding ShowNotificationSettings}" Clicked="OpenSettingsClicked"
                                    AutomationId="onboarding-notification-settings" />
                        </VerticalStackLayout>
                        <Label Text="Not now? That's fine. You can enable reminders later in Settings."
                               Style="{StaticResource Secondary}" FontSize="14" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
    </ContentPage.Resources>
    <Grid RowDefinitions="*,Auto" RowSpacing="0" SafeAreaEdges="None">
        <CarouselView x:Name="Carousel" ItemsSource="{Binding Slides}" Loop="False"
                      PositionChanged="PositionChanged" IndicatorView="Progress"
                      AutomationId="onboarding-carousel">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="View">
                    <ContentView Content="{Binding .}" SafeAreaEdges="None" />
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>
        <Grid Grid.Row="1" RowDefinitions="Auto,Auto">
            <BoxView HeightRequest="1" InputTransparent="True" />
            <VerticalStackLayout Grid.Row="1" Padding="24,16,24,8" Spacing="12"
                                 MaximumWidthRequest="600" HorizontalOptions="Fill">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <IndicatorView x:Name="Progress" IndicatorSize="7" HorizontalOptions="Start" VerticalOptions="Center"
                           IndicatorColor="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                           SelectedIndicatorColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}"
                           InputTransparent="True" />
                    <Label Grid.Column="1" Text="{Binding ProgressText}" Style="{StaticResource Secondary}" FontSize="13"
                           VerticalOptions="Center" AutomationId="onboarding-progress" />
                </Grid>
                <VerticalStackLayout Spacing="4">
                    <Button Text="{Binding NextText}" Clicked="NextClicked" IsEnabled="{Binding CanNavigate}"
                            Style="{StaticResource OnboardingNext}" AutomationId="onboarding-next" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                        <Button Text="Back" Clicked="BackClicked" IsVisible="{Binding CanGoBack}" LineBreakMode="WordWrap"
                                IsEnabled="{Binding CanNavigate}" Style="{StaticResource QuietButton}" BorderWidth="0"
                                HorizontalOptions="Start" AutomationId="onboarding-back" />
                        <Button Grid.Column="1" Text="Skip setup" Clicked="SkipClicked" IsEnabled="{Binding CanNavigate}" LineBreakMode="WordWrap"
                                Style="{StaticResource QuietButton}" BorderWidth="0"
                                HorizontalOptions="End" AutomationId="onboarding-skip" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
