<ContentPage x:Class="DotNetConf.App.Pages.OnboardingPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:DotNetConf.App.Pages"
             x:DataType="pages:OnboardingPage"
             Shell.NavBarIsVisible="False" NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="All,None,All,All" AutomationId="onboarding-page">
    <ContentPage.Resources>
        <Style x:Key="OnboardingHeading" TargetType="Label" BasedOn="{StaticResource Heading}">
            <Setter Property="FontSize" Value="34" />
        </Style>
        <Style x:Key="OnboardingLead" TargetType="Label" BasedOn="{StaticResource BaseLabel}">
            <Setter Property="FontSize" Value="18" />
        </Style>
        <DataTemplate x:Key="WelcomeTemplate" x:DataType="pages:OnboardingPage">
            <ScrollView SafeAreaEdges="None" AutomationId="onboarding-welcome-scroll">
                <VerticalStackLayout Spacing="0" SafeAreaEdges="None">
                    <Grid SafeAreaEdges="None" Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}">
                        <VerticalStackLayout Padding="24,32,24,28" Spacing="24" MaximumWidthRequest="600"
                                             HorizontalOptions="Fill" SafeAreaEdges="None">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Image Source="{StaticResource OnboardingAgendaIcon}" HeightRequest="48" WidthRequest="48"
                                       HorizontalOptions="Start" InputTransparent="True"
                                       AutomationProperties.IsInAccessibleTree="False" />
                                <Button Grid.Column="1" Text="Skip setup" Clicked="SkipClicked" IsEnabled="{Binding CanNavigate}"
                                        LineBreakMode="WordWrap" Style="{StaticResource QuietButton}" BorderWidth="0"
                                        HorizontalOptions="End" VerticalOptions="Center" AutomationId="onboarding-skip" />
                            </Grid>
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Your front row&#10;to .NET Conf." Style="{StaticResource OnboardingHeading}"
                                       AutomationId="onboarding-welcome" />
                                <Label Text="Find the talks you want to watch and keep them together in your schedule."
                                       Style="{StaticResource OnboardingLead}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Padding="24,28,24,24" Spacing="16" MaximumWidthRequest="600"
                                         HorizontalOptions="Fill">
                        <Label Text="Save a session with its heart. Your choices stay on this device." />
                        <Button Text="Help me choose sessions" Clicked="OpenPlannerClicked"
                                IsEnabled="{Binding CanNavigate}" Style="{StaticResource ConferenceSecondaryAction}"
                                AutomationId="onboarding-open-planner" />
                        <Button Text="Set up session reminders" Clicked="OpenRemindersClicked"
                                IsEnabled="{Binding CanNavigate}" Style="{StaticResource ConferenceTextAction}"
                                AutomationId="onboarding-open-reminders" />
                        <Label Text="The agenda downloads from Microsoft and is available offline afterward."
                               Style="{StaticResource Secondary}" FontSize="13" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
        <DataTemplate x:Key="ScheduleIntroTemplate" x:DataType="pages:OnboardingPage">
            <ScrollView SafeAreaEdges="None" AutomationId="onboarding-schedule-scroll">
                <VerticalStackLayout Spacing="0" SafeAreaEdges="None">
                    <Grid SafeAreaEdges="None" Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}">
                        <VerticalStackLayout Padding="24,32,24,28" Spacing="24" MaximumWidthRequest="600"
                                             HorizontalOptions="Fill" SafeAreaEdges="None">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Image Source="{StaticResource OnboardingHeartIcon}" HeightRequest="48" WidthRequest="48"
                                       HorizontalOptions="Start" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" />
                                <Button Grid.Column="1" Text="Skip setup" Clicked="SkipClicked" IsEnabled="{Binding CanNavigate}"
                                        LineBreakMode="WordWrap" Style="{StaticResource QuietButton}" BorderWidth="0"
                                        HorizontalOptions="End" VerticalOptions="Center" AutomationId="onboarding-skip" />
                            </Grid>
                            <VerticalStackLayout Spacing="16">
                                <Label Text="A little heart.&#10;Your own lineup." Style="{StaticResource OnboardingHeading}"
                                       AutomationId="onboarding-manual-title" />
                                <Label Text="Tap the heart on any talk to save it to My Schedule. Tap again to remove it."
                                       Style="{StaticResource OnboardingLead}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Padding="24,24" Spacing="16" MaximumWidthRequest="600" HorizontalOptions="Fill">
                        <ActivityIndicator IsRunning="{Binding PreparingScheduleStep}" IsVisible="{Binding PreparingScheduleStep}"
                                           HorizontalOptions="Start" AutomationId="onboarding-model-check"
                                           SemanticProperties.Description="Checking on-device planning availability" />
                        <Label Text="Checking whether on-device planning is available. You can keep going."
                               IsVisible="{Binding PreparingScheduleStep}" Style="{StaticResource Secondary}" FontSize="14" />
                        <Label Text="Find the full agenda in Sessions. Explore topics and speakers, then heart the talks you don't want to miss."
                               AutomationId="onboarding-manual-explanation" />
                        <Label Text="Your saved talks stay together in My Schedule. You can change your mind any time."
                               Style="{StaticResource Secondary}" FontSize="14" />
                        <Label Text="No app account needed. Your schedule stays on this device."
                               Style="{StaticResource Secondary}" FontSize="14" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
        <DataTemplate x:Key="RemindersTemplate" x:DataType="pages:OnboardingPage">
            <ScrollView SafeAreaEdges="None" AutomationId="onboarding-reminders-scroll">
                <VerticalStackLayout Spacing="0" SafeAreaEdges="None">
                    <Grid SafeAreaEdges="None" Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}">
                        <VerticalStackLayout Padding="24,32,24,28" Spacing="24" MaximumWidthRequest="600"
                                             HorizontalOptions="Fill" SafeAreaEdges="None">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                <Image Source="{StaticResource ReminderIcon}" HeightRequest="48" WidthRequest="48"
                                       HorizontalOptions="Start" InputTransparent="True"
                                       AutomationProperties.IsInAccessibleTree="False" />
                                <Button Grid.Column="1" Text="Skip setup" Clicked="SkipClicked" IsEnabled="{Binding CanNavigate}"
                                        LineBreakMode="WordWrap" Style="{StaticResource QuietButton}" BorderWidth="0"
                                        HorizontalOptions="End" VerticalOptions="Center" AutomationId="onboarding-skip" />
                            </Grid>
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Less clock-watching.&#10;More conference." Style="{StaticResource OnboardingHeading}"
                                       AutomationId="onboarding-reminders-title" />
                                <Label Text="Get a reminder when a session in My Schedule begins. We'll ask your device for notification permission only if you choose to enable it."
                                       Style="{StaticResource OnboardingLead}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Padding="24,28,24,24" Spacing="20" MaximumWidthRequest="600"
                                         HorizontalOptions="Fill">
                        <Label Text="Reminders stay on this device. Your device controls when they appear."
                               Style="{StaticResource Secondary}" FontSize="14" />
                        <VerticalStackLayout Spacing="12">
                            <Button Text="Enable session reminders" Clicked="EnableRemindersClicked" LineBreakMode="WordWrap"
                                    IsVisible="{Binding ShowEnableReminders}" IsEnabled="{Binding CanRequestReminders}"
                                    AutomationId="onboarding-enable-reminders" />
                            <Button Text="Retry reminders" Clicked="RetryRemindersClicked" LineBreakMode="WordWrap"
                                    IsVisible="{Binding ShowRetryReminders}" IsEnabled="{Binding CanRequestReminders}"
                                    AutomationId="onboarding-retry-reminders" />
                            <ActivityIndicator IsRunning="{Binding RequestingReminders}" IsVisible="{Binding RequestingReminders}"
                                               HorizontalOptions="Start" AutomationId="onboarding-reminders-loading"
                                               SemanticProperties.Description="Enabling session reminders" />
                            <Label Text="{Binding ReminderStatus}" IsVisible="{Binding ShowReminderStatus}"
                                   AutomationId="onboarding-reminder-status" SemanticProperties.Description="{Binding ReminderStatus}" />
                            <Button Text="Open device settings" Style="{StaticResource QuietButton}" LineBreakMode="WordWrap"
                                    IsVisible="{Binding ShowNotificationSettings}" Clicked="OpenSettingsClicked"
                                    AutomationId="onboarding-notification-settings" />
                        </VerticalStackLayout>
                        <Label Text="Not now? That's fine. You can enable reminders later in Settings."
                               Style="{StaticResource Secondary}" FontSize="14" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>
    </ContentPage.Resources>
    <Grid SafeAreaEdges="None" Background="{AppThemeBinding Light={StaticResource HeroLightGradient}, Dark={StaticResource HeroDarkGradient}}">
        <Grid RowDefinitions="*,Auto" RowSpacing="0" SafeAreaEdges="None,Container,None,None">
            <CarouselView x:Name="Carousel" ItemsSource="{Binding Slides}" Loop="False" IsSwipeEnabled="False"
                          BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
                          HorizontalScrollBarVisibility="Never"
                          PositionChanged="PositionChanged"
                          AutomationId="onboarding-carousel">
                <CarouselView.ItemTemplate>
                    <DataTemplate x:DataType="View">
                        <ContentView Content="{Binding .}" SafeAreaEdges="None" />
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>
            <Grid Grid.Row="1" RowDefinitions="Auto,Auto" SafeAreaEdges="None"
                  BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
                <BoxView HeightRequest="1" InputTransparent="True" />
                <Grid Grid.Row="1" Padding="24,12,24,12" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                      MaximumWidthRequest="600" HorizontalOptions="Fill">
                    <Button Text="Back" Clicked="BackClicked" IsVisible="{Binding CanGoBack}" LineBreakMode="WordWrap"
                            IsEnabled="{Binding CanNavigate}" Style="{StaticResource QuietButton}" BorderWidth="0"
                            HorizontalOptions="Start" VerticalOptions="Center" AutomationId="onboarding-back" />
                    <Button Grid.Column="1" Text="{Binding NextText}" Clicked="NextClicked" IsEnabled="{Binding CanNavigate}"
                            LineBreakMode="WordWrap" HorizontalOptions="End" VerticalOptions="Center"
                            MinimumWidthRequest="80" AutomationId="onboarding-next">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding Source={x:Reference Carousel}, Path=Position, x:DataType=CarouselView}" Value="0">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="HorizontalOptions" Value="Fill" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
