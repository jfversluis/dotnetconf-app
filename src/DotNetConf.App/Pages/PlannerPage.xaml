<ContentPage x:Class="DotNetConf.App.Pages.PlannerPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DotNetConf.App.Controls"
             xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
             x:DataType="vm:PlannerViewModel" Title="Plan my schedule"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <controls:PlannerView />
        <Button Grid.Row="1" Text="View My Schedule" Margin="24,8,24,16" LineBreakMode="WordWrap"
                IsVisible="{Binding HasAddedSessions}" Clicked="ViewScheduleClicked"
                AutomationId="planner-view-schedule" />
    </Grid>
</ContentPage>
