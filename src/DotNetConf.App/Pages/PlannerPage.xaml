<ContentPage x:Class="DotNetConf.App.Pages.PlannerPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DotNetConf.App.Controls"
             xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
             x:DataType="vm:PlannerViewModel" Title="Plan my schedule"
             Shell.TabBarIsVisible="False">
    <Grid RowDefinitions="*,Auto">
        <Grid.SafeAreaEdges>
            <OnPlatform x:TypeArguments="SafeAreaEdges" Default="Default">
                <On Platform="iOS" Value="Container,None,Container,None" />
            </OnPlatform>
        </Grid.SafeAreaEdges>
        <controls:PlannerView x:Name="Planner" />
        <Grid Grid.Row="1" IsVisible="{Binding HasAddedSessions}">
            <Grid.SafeAreaEdges>
                <OnPlatform x:TypeArguments="SafeAreaEdges" Default="None">
                    <On Platform="iOS" Value="None,None,None,Container" />
                </OnPlatform>
            </Grid.SafeAreaEdges>
            <Button Text="View My Schedule" Margin="24,8,24,16" LineBreakMode="WordWrap"
                    IsEnabled="{Binding CanEdit}" Clicked="ViewScheduleClicked" AutomationId="planner-view-schedule" />
        </Grid>
    </Grid>
</ContentPage>
