<pages:AdaptiveConferencePage x:Class="DotNetConf.App.Pages.SchedulePage"
                      x:Name="Page"
                      xmlns:pages="clr-namespace:DotNetConf.App.Pages"
                      xmlns:controls="clr-namespace:DotNetConf.App.Controls"
                      xmlns:planner="clr-namespace:DotNetConf.App.Planner"
                      xmlns:vm="clr-namespace:DotNetConf.App.ViewModels"
                      x:DataType="vm:ConferenceViewModel" Title="My Schedule">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="PlannerToolbar" Text="{Binding SchedulePlannerAction}"
                     IconImageSource="{StaticResource DiscoveryActionIcon}"
                     Command="{Binding FillScheduleGapsCommand}" Order="Primary"
                     SemanticProperties.Description="{Binding SchedulePlannerAction}"
                     SemanticProperties.Hint="{Binding SchedulePlannerHint}"
                     AutomationId="schedule-ai-planner-toolbar" />
    </ContentPage.ToolbarItems>
    <Grid x:Name="ScheduleRoot" RowDefinitions="Auto,*" SafeAreaEdges="Container,None,Container,None">
        <VerticalStackLayout Padding="24,12,24,12" Spacing="8" AutomationId="schedule-header">
            <Label x:Name="ScheduleHeading" Text="Your conference, your way" Style="{StaticResource Subheading}"
                   SemanticProperties.HeadingLevel="Level1" AutomationId="schedule-heading" />
            <!-- The track sits behind the buttons rather than around them: on the Avalonia host, the focus
                 adorner of a control inside a clipping Border throws when tabbed to. -->
            <Grid HorizontalOptions="Start">
                <Border StrokeShape="RoundRectangle 27"
                        Stroke="{AppThemeBinding Light={StaticResource LightOutline}, Dark={StaticResource DarkOutline}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}" />
                <HorizontalStackLayout Spacing="2" Padding="3">
                    <Button x:Name="TimelineButton" Text="Timeline" Clicked="OnTimelineClicked" CornerRadius="24"
                            Padding="18,0" BorderWidth="0" AutomationId="schedule-timeline-mode"
                            SemanticProperties.Hint="Shows only your saved sessions on a timeline" />
                    <Button x:Name="ListButton" Text="List" Clicked="OnListClicked" CornerRadius="24"
                            Padding="18,0" BorderWidth="0" AutomationId="schedule-list-mode"
                            SemanticProperties.Hint="Shows only your saved sessions as a list" />
                </HorizontalStackLayout>
            </Grid>
            <Label x:Name="ScheduleTimeZone" Text="{Binding TimeZoneLabel}" Style="{StaticResource Secondary}" FontSize="12"
                   AutomationId="schedule-timezone" />
            <Label x:Name="CompactTimeZone" Text="{Binding CompactTimeZoneLabel}" Style="{StaticResource Secondary}"
                   FontSize="12" IsVisible="False" SemanticProperties.Description="{Binding TimeZoneLabel}"
                   AutomationId="schedule-timezone-compact" />
            <Button x:Name="PlannerAction" Text="{Binding SchedulePlannerAction}" Command="{Binding FillScheduleGapsCommand}"
                    ImageSource="{StaticResource DiscoveryActionIcon}" ContentLayout="Left,10"
                    Style="{StaticResource ConferenceTextAction}" AutomationId="schedule-ai-planner"
                    SemanticProperties.Description="{Binding SchedulePlannerAction}"
                    SemanticProperties.Hint="{Binding SchedulePlannerHint}" />
            <ContentView x:Name="FullScheduleStatus" IsVisible="False">
                <controls:StatusBanner AutomationId="schedule-status" />
            </ContentView>
            <controls:CompactSearchStatus x:Name="CompactScheduleStatus" IsVisible="False"
                                          AutomationId="schedule-compact-status" />
        </VerticalStackLayout>
        <planner:SchedulePlanner x:Name="Planner" Grid.Row="1" Sessions="{Binding SavedTimelineSessions}"
                                 Topics="{Binding Topics}"
                                 SelectedId="{Binding Source={x:Reference Page}, Path=SelectedId, x:DataType=pages:SchedulePage}"
                                 ClearTopicsCommand="{Binding ClearTopicFiltersCommand}" AutomationId="schedule-planner" />
        <RefreshView x:Name="SavedList" Grid.Row="1" IsVisible="False"
                     IsRefreshing="{Binding IsPullRefreshing, Mode=TwoWay}"
                     Command="{Binding RequestRefreshCommand}"
                     RefreshColor="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}"
                     AutomationId="schedule-refresh">
        <CollectionView ItemsSource="{Binding SavedSessions}" ItemsUpdatingScrollMode="KeepScrollOffset"
                        SelectionMode="None" AutomationId="saved-session-list">
            <CollectionView.Footer>
                <controls:SafeAreaFooter Page="{x:Reference Page}" />
            </CollectionView.Footer>
            <CollectionView.Header>
                <VerticalStackLayout Spacing="12" Padding="24,8,24,8" SafeAreaEdges="None">
                    <Label Text="{Binding ScheduleSummary}" FontFamily="OpenSansSemibold" AutomationId="saved-count" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SessionViewModel">
                    <Grid Padding="24,0">
                        <controls:SessionRow SelectedId="{Binding Source={RelativeSource AncestorType={x:Type pages:AdaptiveConferencePage}}, Path=SelectedId}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,32" Spacing="16">
                    <Image Source="{StaticResource HeartOutlineIcon}" WidthRequest="32" HeightRequest="32"
                           HorizontalOptions="Start" AutomationProperties.IsInAccessibleTree="False" />
                    <ActivityIndicator IsRunning="{Binding IsInitialAgendaLoading}" IsVisible="{Binding IsInitialAgendaLoading}"
                                       HorizontalOptions="Start" AutomationId="schedule-initial-loading" />
                    <Label Text="{Binding ScheduleEmptyTitle}" Style="{StaticResource Subheading}" AutomationId="schedule-empty-title" />
                    <Label Text="{Binding ScheduleEmptyMessage}" Style="{StaticResource Secondary}" AutomationId="schedule-empty-message" />
                    <Button Text="Find a session" Command="{Binding BrowseSessionsCommand}" AutomationId="schedule-browse" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
        </RefreshView>
    </Grid>
</pages:AdaptiveConferencePage>
