<ContentPage x:Class="DotNetConf.App.Pages.SettingsPage"
             xmlns:pages="clr-namespace:DotNetConf.App.Pages"
             xmlns:controls="clr-namespace:DotNetConf.App.Controls"
             x:DataType="pages:SettingsPage" Title="Settings">
    <Grid SafeAreaEdges="Container,None,Container,None">
    <ScrollView SafeAreaEdges="Default" AutomationId="settings-scroll">
        <VerticalStackLayout Padding="24" Spacing="28" MaximumWidthRequest="720"
                             HorizontalOptions="Center" SafeAreaEdges="None">
            <VerticalStackLayout Spacing="12">
                <Label Text="Make it yours" Style="{StaticResource Heading}" />
                <Label Text="Choose how the app looks. Your preference stays on this device."
                       Style="{StaticResource Secondary}" />
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="12">
                <Label Text="Appearance" Style="{StaticResource Subheading}" />
                <Border StrokeShape="RoundRectangle 8" Padding="12,0">
                    <controls:AgendaPicker x:Name="AppearancePicker" Title="Appearance"
                                           ItemsSource="{Binding AppearanceChoices}"
                                           SelectedIndexChanged="OnAppearanceChanged"
                                           AutomationId="settings-appearance"
                                           SemanticProperties.Description="App appearance" />
                </Border>
                <Label Text="System follows your device's light or dark appearance."
                       Style="{StaticResource Secondary}" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <VerticalStackLayout Spacing="12">
                <Label Text="Agenda times" Style="{StaticResource Subheading}" />
                <Label Text="{Binding TimeZoneLabel}" AutomationId="settings-time-zone" />
                <Label Text="Session times follow your device's time zone, including daylight saving time. To change it, use your device settings."
                       Style="{StaticResource Secondary}" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <VerticalStackLayout Spacing="12">
                <Label Text="Session reminders" Style="{StaticResource Subheading}" />
                <Label Text="Get a local notification when a saved session begins. Your device controls delivery."
                       Style="{StaticResource Secondary}" />
                <Label Text="{Binding Reminders.Status}" AutomationId="settings-reminder-status" />
                <Button Text="Enable reminders" Clicked="EnableRemindersClicked" LineBreakMode="WordWrap"
                        IsVisible="{Binding Reminders.CanEnable}" IsEnabled="{Binding CanChangeReminders}"
                        Style="{StaticResource QuietButton}" AutomationId="settings-enable-reminders" />
                <Button Text="Retry reminders" Clicked="RetryRemindersClicked" LineBreakMode="WordWrap"
                        IsVisible="{Binding Reminders.CanRetry}" IsEnabled="{Binding CanChangeReminders}"
                        Style="{StaticResource QuietButton}" AutomationId="settings-retry-reminders" />
                <Button Text="Turn off reminders" Clicked="DisableRemindersClicked" LineBreakMode="WordWrap"
                        IsVisible="{Binding Reminders.Enabled}" IsEnabled="{Binding CanChangeReminders}" Style="{StaticResource QuietButton}"
                        AutomationId="settings-disable-reminders" />
                <Button Text="Open device settings" Clicked="NotificationSettingsClicked" LineBreakMode="WordWrap"
                        IsVisible="{Binding Reminders.PermissionBlocked}" Style="{StaticResource QuietButton}"
                        AutomationId="settings-notification-settings" />
            </VerticalStackLayout>
            <BoxView HeightRequest="1" />
            <VerticalStackLayout Spacing="12">
                <Label Text="About this app" Style="{StaticResource Subheading}" />
                <Label Text="Conference information, privacy, and acknowledgments."
                       Style="{StaticResource Secondary}" />
                <Button Text="About" ImageSource="{StaticResource AboutIcon}"
                        Style="{StaticResource QuietButton}" Clicked="OnAboutClicked"
                        AutomationId="settings-about"
                        SemanticProperties.Description="About .NET Conf companion" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
