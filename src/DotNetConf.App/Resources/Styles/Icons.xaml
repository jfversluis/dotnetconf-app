                     Color="{AppThemeBinding Light={StaticResource Purple}, Dark={StaticResource Lavender}}" />
    <FontImageSource x:Key="InPersonIcon" Glyph="{x:Static icons:FluentIconsRegular.Presenter24}"
                     FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}" Size="24"
                     Color="{AppThemeBinding Light={StaticResource Magenta}, Dark={StaticResource Lavender}}" />
