                     FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}" Size="24"
                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Midnight}}" />
    <FontImageSource x:Key="PrimaryEventListIcon" Glyph="{x:Static icons:FluentIconsRegular.List24}"
                     FontFamily="{x:Static icons:FluentIconsRegular.FontFamily}" Size="24"
                     Color="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Midnight}}" />
